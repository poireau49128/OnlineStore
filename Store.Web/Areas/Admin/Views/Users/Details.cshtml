@model Store.Web.Areas.Admin.ViewModels.UserDetailsViewModel;

@{
    ViewData["Title"] = "Пользователь";
}


<div class="container-fluid">
    <div class="row">
        <partial name="_AdminSidebar" />
        <main class="col">
            <h2>Пользователь</h2>

            <div class="card">
                <div class="card-body">

                    <dl class="row">
                        <dt class="col-sm-3">Email</dt>
                        <dd class="col-sm-9">@Model.Email</dd>

                        <dt class="col-sm-3">ФИО</dt>
                        <dd class="col-sm-9">@Model.FullName</dd>
                    </dl>

                    <hr />

                    <form asp-action="SetAdminRole" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="UserId" value="@Model.Id" />

                        <div class="form-check">
                            <input class="form-check-input"
                                type="checkbox"
                                name="IsAdmin"
                                value="true"
                                @(Model.IsAdmin ? "checked" : "") />

                            <label class="form-check-label">
                                Администратор
                            </label>
                        </div>

                        @if (Model.IsAdmin)
                        {
                            <input type="hidden" name="IsAdmin" value="false" />
                        }

                        <button type="submit" class="btn btn-primary mt-3">
                            Сохранить
                        </button>
                    </form>

                    <!-- Сброс пароля -->
                    <form asp-action="ResetPassword" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@Model.Id" />
                        <button type="submit" class="btn btn-warning mt-2">Сбросить пароль</button>
                    </form>

                    <!-- Список скидок -->
                    <h4 class="mt-4">Скидки по категориям</h4>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Тип</th>
                                <th>Категория</th>
                                <th>%</th>
                                <th>До</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.CategoryDiscounts)
                            {
                                <tr>
                                    <td>@d.ProductTypeName</td>
                                    <td>@d.CategoryName</td>
                                    <td>@d.DiscountPercent%</td>
                                    <td>@(d.Expiration?.ToString("dd.MM.yyyy") ?? "∞")</td>
                                    <td>
                                        <form asp-action="RemoveCategoryDiscount" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="discountId" value="@d.Id" />
                                            <input type="hidden" name="userId" value="@Model.Id" />
                                            <button class="btn btn-sm btn-danger">✕</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <h5 class="mt-4">Добавить скидку</h5>
                    <form asp-action="AddCategoryDiscount" method="post" class="row g-2">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="userId" value="@Model.Id" />

                        <div class="col-md-3">
                            <label class="form-label">Тип товара</label>
                            <select id="typeSelect" class="form-select">
                                <option value="">— выберите —</option>
                                @foreach (var type in Model.ProductTypes)
                                {
                                    <option value="@type.Id">@type.Name</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Категория</label>
                            <select id="categorySelect" name="categoryId" class="form-select" required>
                                <option value="">— выберите тип —</option>
                                @foreach (var type in Model.ProductTypes)
                                {
                                    foreach (var cat in type.Categories)
                                    {
                                        <option value="@cat.Id" data-type="@type.Id">
                                            @cat.Name
                                        </option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">Скидка %</label>
                            <input type="number"
                                name="percent"
                                class="form-control"
                                min="1"
                                max="100"
                                required />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Действует до</label>
                            <input type="date"
                                name="expiration"
                                class="form-control" />
                        </div>

                        <div class="col-md-1 d-flex align-items-end">
                            <button class="btn btn-success w-100">+</button>
                        </div>
                    </form>



                    <!-- Список заказов -->
                    <h4 class="mt-4">Заказы пользователя</h4>
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>№</th>
                                <th>Дата</th>
                                <th>Статус</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var order in Model.Orders)
                            {
                                <tr>
                                    <td>@order.Id</td>
                                    <td>@order.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>@order.Status</td>
                                    <td>
                                        <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-primary">
                                            Детали
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            </div>
            <a asp-action="Index" class="btn btn-link mt-3">← Назад</a>
        </main>
    </div>
</div>

@section Scripts{
    <script>
        const typeSelect = document.getElementById('typeSelect');
        const categorySelect = document.getElementById('categorySelect');

        typeSelect.addEventListener('change', () => {
            const typeId = typeSelect.value;

            Array.from(categorySelect.options).forEach(opt => {
                if (!opt.dataset.type) return;

                opt.hidden = opt.dataset.type !== typeId;
            });

            categorySelect.value = '';
        });
    </script>

}