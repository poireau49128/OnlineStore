@model Store.Web.Areas.Admin.ViewModels.CreateProductViewModel
@using Store.Application.Utilities

@{
    ViewData["Title"] = "Добавить товар";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <partial name="_AdminSidebar" />
        <main class="col">
            <h1 class="mb-4">Добавить новый товар</h1>

            <form method="post" enctype="multipart/form-data" class="card p-4" novalidate>
                @{
                    var hasErrors = !ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Any());
                }

                @if (hasErrors)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>Ошибки при заполнении:</strong>
                        <ul class="mb-0 mt-2">
                            @foreach (var state in ViewData.ModelState)
                            {
                                @foreach (var error in state.Value.Errors)
                                {
                                    var message = error.ErrorMessage;
                                    var fieldName = state.Key;

                                    if (message.Contains("is invalid", StringComparison.OrdinalIgnoreCase) || 
                                        message.Contains("is required", StringComparison.OrdinalIgnoreCase))
                                    {
                                        message = fieldName switch
                                        {
                                            "CategoryId" => "Категория не выбрана",
                                            "BasePrice" => "Укажите корректную цену",
                                            "Name" => "Название обязательно",
                                            _ => $"Ошибка в поле {fieldName}"
                                        };
                                    }
                                    
                                    <li>@message</li>
                                }
                            }
                        </ul>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <h5 class="mb-3">Основные данные товара</h5>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label">Название <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="Зеркало навесное ЗН-150" maxlength="200" />
                        <small class="text-muted">Макс. 200 символов</small>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Sku" class="form-label">Артикул</label>
                        <input asp-for="Sku" class="form-control" placeholder="Авто" maxlength="50" />
                        <small class="text-muted">Оставить пустым = автогенерация</small>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="BasePrice" class="form-label">Цена <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input asp-for="BasePrice" class="form-control" type="number" step="0.01" min="0.01" placeholder="0.00" />
                            <span class="input-group-text">@CurrencyHelper.DefaultCurrency</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">
                            Категория <span class="text-danger">*</span>
                        </label>

                        <div class="d-flex gap-2">
                            <select asp-for="CategoryId" class="form-select" id="categorySelect">
                                <option value="">-- Выберите категорию --</option>
                                @foreach (var group in Model.Categories
                                    .GroupBy(c => c.ProductTypeName)
                                    .OrderBy(g => g.Key))
                                {
                                    <optgroup label="@group.Key">
                                        @foreach (var cat in group.OrderBy(c => c.Name))
                                        {
                                            <option value="@cat.Id">@cat.Name</option>
                                        }
                                    </optgroup>
                                }
                            </select>

                            <button type="button"
                                    class="btn btn-outline-primary"
                                    data-bs-toggle="modal"
                                    data-bs-target="#createCategoryModal">
                                ＋
                            </button>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Описание</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Подробное описание..." maxlength="2000"></textarea>
                    <small class="text-muted">Макс. 2000 символов</small>
                </div>

                <hr class="my-4" />

                <h5 class="mb-3">Первый вариант товара <span class="text-danger">*</span></h5>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label asp-for="FirstVariantColor" class="form-label">Цвет <span class="text-danger">*</span></label>
                        <input asp-for="FirstVariantColor" class="form-control" placeholder="Артисан" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="FirstVariantSize" class="form-label">Размер</label>
                        <input asp-for="FirstVariantSize" class="form-control" placeholder="19х64" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Своя цена</label>
                        <div class="input-group">
                            <input asp-for="FirstVariantPrice" class="form-control" type="number" step="0.01" placeholder="Оставить пустым" />
                            <span class="input-group-text">@CurrencyHelper.DefaultCurrency</span>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Изображения</label>
                    <div class="mb-2" id="imagePreview"></div>
                    <input asp-for="FirstVariantImages" type="file" class="form-control" multiple accept=".jpg,.jpeg,.png,.webp" id="imageInput" />
                    <small class="text-muted">JPG, PNG, WebP.  Макс. 5 МБ за файл.  Выбирайте ВСЕ сразу! </small>
                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-secondary">Отмена</a>
                    <button type="submit" class="btn btn-primary">Создать товар</button>
                </div>
            </form>
        </main>
    </div>
</div>


<div class="modal fade" id="createCategoryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Новая категория</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Название категории</label>
                    <input id="newCategoryName" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Тип товара</label>
                    <select id="productTypeSelect"
                            class="form-select"
                            asp-items="Model.ProductTypes">
                    </select>

                    <small class="text-muted d-block mt-1">
                        Нет нужного типа? Введите новый ниже
                    </small>
                </div>

                <div class="mb-3">
                    <input id="newProductTypeName"
                           class="form-control"
                           placeholder="Новый тип товара (необязательно)" />
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">
                    Отмена
                </button>
                <button class="btn btn-primary" onclick="createCategory()">
                    Создать
                </button>
            </div>

        </div>
    </div>
</div>




@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            var form = $('form');
            var validator = form.data('validator');

            if (validator) {
                validator.settings.showErrors = function (errorMap, errorList) {
                    this.defaultShowErrors();
                    $('.field-validation-valid, .field-validation-error').hide();
                };
                form.on('invalid-form.validate', function(event, validator) {
                    console.log("Ошибок найдено: " + validator.numberOfInvalids());
                });
            }
        });

        // Предпросмотр изображений
        document.getElementById('imageInput')?. addEventListener('change', function(e) {
            const preview = document.getElementById('imagePreview');
            preview.innerHTML = '';
            
            Array.from(e.target.files).forEach(file => {
                const reader = new FileReader();
                reader.onload = function(event) {
                    const div = document.createElement('div');
                    div.className = 'mb-2 position-relative d-inline-block me-2';
                    div. innerHTML = `
                        <img src="${event.target.result}" style="max-width: 100px; max-height: 100px; border-radius: 4px;">
                        <small class="d-block text-muted text-truncate" style="max-width: 100px;">${file.name}</small>
                    `;
                    preview.appendChild(div);
                };
                reader.readAsDataURL(file);
            });
        });


        async function createCategory() {
            const name = document.getElementById('newCategoryName').value.trim();
            const typeId = document.getElementById('productTypeSelect').value;
            const newTypeName = document.getElementById('newProductTypeName').value.trim();

            if (!name) {
                alert('Введите название категории');
                return;
            }

            const response = await fetch('/Admin/Categories/CreateAjax', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    name,
                    productTypeId: newTypeName ? null : typeId,
                    newProductTypeName: newTypeName || null
                })
            });

            if (!response.ok) {
                alert('Ошибка при создании категории');
                return;
            }

            const result = await response.json();

            const select = document.getElementById('categorySelect');

            let group = [...select.querySelectorAll('optgroup')]
                .find(g => g.label === result.productTypeName);

            if (!group) {
                group = document.createElement('optgroup');
                group.label = result.productTypeName;
                select.appendChild(group);
            }

            const option = document.createElement('option');
            option.value = result.id;
            option.textContent = result.name;
            option.selected = true;

            group.appendChild(option);

            bootstrap.Modal.getInstance(
                document.getElementById('createCategoryModal')
            ).hide();
        }
    </script>
}