@model Store.Web.Areas.Admin.ViewModels.CreateProductViewModel

@{
    ViewData["Title"] = "Добавить товар";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <partial name="_AdminSidebar" />
        <main class="col">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>✨ Добавить новый товар</h1>
                <a asp-action="Index" class="btn btn-secondary">← Назад</a>
            </div>

            <form method="post" enctype="multipart/form-data" class="card p-4">
                <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>

                <!-- ОСНОВНЫЕ ДАННЫЕ ТОВАРА -->
                <h5 class="mb-3">📦 Основные данные товара</h5>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label">Наименование</label>
                        <input asp-for="Name" class="form-control" placeholder="Например:  Зеркало навесное ЗН-150" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Sku" class="form-label">Артикул</label>
                        <input asp-for="Sku" class="form-control" placeholder="Оставить пустым для автогенерации" />
                        <small class="text-muted">Если не указать — генерируется автоматически</small>
                        <span asp-validation-for="Sku" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="BasePrice" class="form-label">Базовая цена</label>
                        <div class="input-group">
                            <input asp-for="BasePrice" class="form-control" type="number" step="0.01" placeholder="0. 00" />
                            <span class="input-group-text">BYN</span>
                        </div>
                        <span asp-validation-for="BasePrice" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label">Категория</label>
                        <select asp-for="CategoryId" class="form-select">
                            <option value="">-- Выберите категорию --</option>
                            @foreach (var group in Model.Categories. GroupBy(c => c.ProductTypeName))
                            {
                                <optgroup label="@group.Key">
                                    @foreach (var cat in group)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                </optgroup>
                            }
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Описание</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Подробное описание товара(опц.)... "></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <hr class="my-4" />

                <!-- ПЕРВЫЙ ВАРИАНТ -->
                <h5 class="mb-3">🎨 Первый вариант товара (обязательно)</h5>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label asp-for="FirstVariantColor" class="form-label">Цвет</label>
                        <input asp-for="FirstVariantColor" class="form-control" placeholder="Например: ПП Кремона Латунь" />
                        <span asp-validation-for="FirstVariantColor" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="FirstVariantSize" class="form-label">Размер</label>
                        <input asp-for="FirstVariantSize" class="form-control" placeholder="Например: 1487х738х54 (опц.)" />
                        <span asp-validation-for="FirstVariantSize" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="FirstVariantPrice" class="form-label">Цена варианта</label>
                        <div class="input-group">
                            <input asp-for="FirstVariantPrice" class="form-control" type="number" step="0.01" placeholder="Своя цена (опц.)" />
                            <span class="input-group-text">BYN</span>
                        </div>
                        <small class="text-muted">Оставить пустым = базовая цена</small>
                        <span asp-validation-for="FirstVariantPrice" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="FirstVariantImages" class="form-label">Изображение</label>
                    <input asp-for="FirstVariantImages" type="file" class="form-control" multiple accept=".jpg,.jpeg,.png,.webp" />
                    <small class="text-muted">Форматы: JPG, PNG, WebP.  Максимум 5 МБ за файл</small>
                    <span asp-validation-for="FirstVariantImages" class="text-danger small"></span>
                </div>

                <hr class="my-4" />

                <!-- КНОПКИ -->
                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-secondary">Отмена</a>
                    <button type="submit" class="btn btn-primary">✅ Создать товар</button>
                </div>
            </form>
        </main>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}