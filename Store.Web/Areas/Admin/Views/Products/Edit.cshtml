@model Store.Web.Areas.Admin.ViewModels.EditProductViewModel
@using Store.Application.Utilities

@{
    ViewData["Title"] = "Редактировать товар";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <partial name="_AdminSidebar" />
        <main class="col">
            <h1 class="mb-4">✏️ Редактировать товар</h1>

            <form method="post" class="card p-4">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        <strong>❌ Ошибки: </strong>
                        <ul class="mb-0">
                            @foreach (var state in ViewData.ModelState.Values)
                            {
                                @foreach (var error in state. Errors)
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            }
                        </ul>
                    </div>
                }

                <input type="hidden" asp-for="ProductId" />

                <div class="row mb-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label">Название <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" maxlength="200" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Sku" class="form-label">Артикул</label>
                        <input asp-for="Sku" class="form-control" maxlength="50" />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-3">
                        <label asp-for="BasePrice" class="form-label">Цена <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input asp-for="BasePrice" class="form-control" type="number" step="0.01" />
                            <span class="input-group-text">@CurrencyHelper.DefaultCurrency</span>
                        </div>
                    </div>
                    <div class="col-mb-3">
                        <label class="form-label d-block">Статус</label>

                        <div class="form-check form-switch">
                            <input class="form-check-input"
                                type="checkbox"
                                asp-for="IsActive"
                                id="productIsActive" />

                            <label class="form-check-label" for="productIsActive" id="productIsActiveLabel">
                                @(Model.IsActive ? "Активен" : "Скрыт")
                            </label>
                        </div>

                        <input type="hidden" asp-for="IsActive" value="false" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label">Категория <span class="text-danger">*</span></label>
                        <select asp-for="CategoryId" class="form-select">
                            <option value="">-- Выберите категорию --</option>
                            @foreach (var group in Model.Categories.GroupBy(c => c. ProductTypeName).OrderBy(g => g.Key))
                            {
                                <optgroup label="@group.Key">
                                    @foreach (var cat in group.OrderBy(c => c.Name))
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>
                    
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Описание</label>
                    <textarea asp-for="Description" class="form-control" rows="3" maxlength="2000"></textarea>
                </div>

                <div class="d-flex gap-2 justify-content-end mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Отмена</a>
                    <button type="submit" class="btn btn-primary">💾 Сохранить</button>
                </div>
            </form>

            <div class="mt-4 pt-4 border-top">
                <h5>Управление товаром</h5>
                <a asp-action="Variants" asp-route-id="@Model.ProductId" class="btn btn-outline-primary">
                    🎨 Варианты
                </a>
            </div>
        </main>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        const checkbox = document.getElementById('productIsActive');
        const label = document.getElementById('productIsActiveLabel');

        if (checkbox && label) {
            const updateLabel = () => {
                label.textContent = checkbox.checked ? 'Активен' : 'Скрыт';
            };

            updateLabel();
            checkbox.addEventListener('change', updateLabel);
        }
    </script>

}