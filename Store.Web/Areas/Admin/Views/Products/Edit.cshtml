@model Store.Web.Areas.Admin.ViewModels.EditProductViewModel

@{
    ViewData["Title"] = "Редактировать товар";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <partial name="_AdminSidebar" />
        <main class="col">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>✏️ Редактировать товар</h1>
                <a asp-action="Index" class="btn btn-secondary">← Назад</a>
            </div>

            <form method="post" class="card p-4">
                <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>

                <input type="hidden" asp-for="ProductId" />

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label">Название</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Sku" class="form-label">Артикул</label>
                        <input asp-for="Sku" class="form-control" />
                        <span asp-validation-for="Sku" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="BasePrice" class="form-label">Базовая цена</label>
                        <div class="input-group">
                            <input asp-for="BasePrice" class="form-control" type="number" step="0.01" />
                            <span class="input-group-text">BYN</span>
                        </div>
                        <span asp-validation-for="BasePrice" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label">Категория</label>
                        <select asp-for="CategoryId" class="form-select">
                            <option value="">-- Выберите категорию --</option>
                            @foreach (var group in Model.Categories.GroupBy(c => c.ProductTypeName))
                            {
                                <optgroup label="@group.Key">
                                    @foreach (var cat in group)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                </optgroup>
                            }
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Описание</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 justify-content-end mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Отмена</a>
                    <button type="submit" class="btn btn-primary">💾 Сохранить</button>
                </div>
            </form>

            <!-- ВАРИАНТЫ И ОСТАТКИ -->
            <div class="mt-4 pt-4 border-top">
                <h5 class="mb-3">Управление товаром</h5>
                <div class="btn-group" role="group">
                    <a asp-action="Variants" asp-route-id="@Model.ProductId" class="btn btn-outline-primary">
                        🎨 Варианты
                    </a>
                </div>
            </div>
        </main>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}