@model Store.Web.Areas.Admin.ViewModels.EditProductViewModel
@using Store.Application.Utilities

@{
    ViewData["Title"] = "Редактировать товар";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <partial name="_AdminSidebar" />
        <main class="col">
            <h1 class="mb-4">Редактировать товар</h1>

            <form method="post" class="card p-4">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        <strong>Ошибки: </strong>
                        <ul class="mb-0">
                            @foreach (var state in ViewData.ModelState.Values)
                            {
                                @foreach (var error in state. Errors)
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            }
                        </ul>
                    </div>
                }

                <input type="hidden" asp-for="ProductId" />

                <div class="row mb-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label">Название <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" maxlength="200" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Sku" class="form-label">Артикул</label>
                        <input asp-for="Sku" class="form-control" maxlength="50" />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-3">
                        <label asp-for="BasePrice" class="form-label">Цена <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input asp-for="BasePrice" class="form-control" type="number" step="0.01" />
                            <span class="input-group-text">@CurrencyHelper.DefaultCurrency</span>
                        </div>
                    </div>
                    <div class="col-mb-3">
                        <label class="form-label d-block">Статус</label>

                        <div class="form-check form-switch">
                            <input class="form-check-input"
                                type="checkbox"
                                asp-for="IsActive"
                                id="productIsActive" />

                            <label class="form-check-label" for="productIsActive" id="productIsActiveLabel">
                                @(Model.IsActive ? "Активен" : "Скрыт")
                            </label>
                        </div>

                        <input type="hidden" asp-for="IsActive" value="false" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">
                            Категория <span class="text-danger">*</span>
                        </label>

                        <div class="d-flex gap-2">
                            <select asp-for="CategoryId" class="form-select" id="categorySelect">
                                <option value="">-- Выберите категорию --</option>
                                @foreach (var group in Model.Categories
                                    .GroupBy(c => c.ProductTypeName)
                                    .OrderBy(g => g.Key))
                                {
                                    <optgroup label="@group.Key">
                                        @foreach (var cat in group.OrderBy(c => c.Name))
                                        {
                                            <option value="@cat.Id">@cat.Name</option>
                                        }
                                    </optgroup>
                                }
                            </select>

                            <button type="button"
                                    class="btn btn-outline-primary"
                                    data-bs-toggle="modal"
                                    data-bs-target="#createCategoryModal">
                                ＋
                            </button>
                        </div>
                    </div>

                    
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Описание</label>
                    <textarea asp-for="Description" class="form-control" rows="3" maxlength="2000"></textarea>
                </div>

                <div class="d-flex gap-2 justify-content-end mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Отмена</a>
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                </div>
            </form>

            <div class="mt-4 pt-4 border-top">
                <h5>Управление товаром</h5>
                <a asp-action="Variants" asp-route-id="@Model.ProductId" class="btn btn-outline-primary">
                    Варианты
                </a>
            </div>
        </main>
    </div>
</div>


<div class="modal fade" id="createCategoryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Новая категория</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Название категории</label>
                    <input id="newCategoryName" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Тип товара</label>
                    <select id="productTypeSelect"
                            class="form-select"
                            asp-items="Model.ProductTypes">
                    </select>

                    <small class="text-muted d-block mt-1">
                        Нет нужного типа? Введите новый ниже
                    </small>
                </div>

                <div class="mb-3">
                    <input id="newProductTypeName"
                           class="form-control"
                           placeholder="Новый тип товара (необязательно)" />
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">
                    Отмена
                </button>
                <button class="btn btn-primary" onclick="createCategory()">
                    Создать
                </button>
            </div>

        </div>
    </div>
</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        const checkbox = document.getElementById('productIsActive');
        const label = document.getElementById('productIsActiveLabel');

        if (checkbox && label) {
            const updateLabel = () => {
                label.textContent = checkbox.checked ? 'Активен' : 'Скрыт';
            };

            updateLabel();
            checkbox.addEventListener('change', updateLabel);
        }

        async function createCategory() {
            const name = document.getElementById('newCategoryName').value.trim();
            const typeId = document.getElementById('productTypeSelect').value;
            const newTypeName = document.getElementById('newProductTypeName').value.trim();

            if (!name) {
                alert('Введите название категории');
                return;
            }

            const response = await fetch('/Admin/Categories/CreateAjax', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    name,
                    productTypeId: newTypeName ? null : typeId,
                    newProductTypeName: newTypeName || null
                })
            });

            if (!response.ok) {
                alert('Ошибка при создании категории');
                return;
            }

            const result = await response.json();

            const select = document.getElementById('categorySelect');

            let group = [...select.querySelectorAll('optgroup')]
                .find(g => g.label === result.productTypeName);

            if (!group) {
                group = document.createElement('optgroup');
                group.label = result.productTypeName;
                select.appendChild(group);
            }

            const option = document.createElement('option');
            option.value = result.id;
            option.textContent = result.name;
            option.selected = true;

            group.appendChild(option);

            bootstrap.Modal.getInstance(
                document.getElementById('createCategoryModal')
            ).hide();
        }

    </script>

}