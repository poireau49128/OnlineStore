@model Store.Web.Areas.Admin.ViewModels.VariantsViewModel
@using Store.Application.Utilities

@{
    ViewData["Title"] = "Варианты товара";
    Layout = "~/Views/Shared/_Layout.cshtml";

    (string Text, string Class) GetStatusDisplay(bool isActive, int stock) => (isActive, stock) switch
    {
        (false, _) => ("Скрыт", "bg-danger"),
        (true, 0) => ("Нет в наличии", "bg-warning text-dark"),
        (true, > 0) => ("Активен", "bg-success"),
        _ => ("Неизвестно", "bg-secondary")
    };
}

<div class="container-fluid">
    <div class="row">
        <partial name="_AdminSidebar" />
        <main class="col">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1>🎨 Варианты:  @Model.ProductName</h1>
                    <p class="text-muted mb-0">Базовая цена: @Model.BasePrice.ToString("0.00") @CurrencyHelper.DefaultCurrency</p>
                </div>
                <a href="@Url.Action("Edit", "Products", new { id = Model.ProductId, area = "Admin" })" 
                   class="btn btn-secondary">← Назад</a>
            </div>

            <!-- СПИСОК ВАРИАНТОВ -->
            @if (Model.Variants.Any())
            {
                <div class="table-responsive mb-4">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Цвет</th>
                                <th>Размер</th>
                                <th>Цена</th>
                                <th>Остатки</th>
                                <th>Изображения</th>
                                <th>Статус</th>
                                <th class="text-end">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var variant in Model.Variants)
                            {
                                <tr>
                                    <td><strong>@variant.Color</strong></td>
                                    <td>@(variant.Size ??  "—")</td>
                                    <td>
                                        <span>@variant.ActualPrice.ToString("0.00") @CurrencyHelper.DefaultCurrency</span>
                                        @if (variant.OverridePrice.HasValue)
                                        {
                                            <small class="text-muted">(своя)</small>
                                        }
                                    </td>
                                    <td><span class="badge bg-info">@variant.TotalStock шт</span></td>
                                    <td><small>@variant.Images.Count изобр. </small></td>
                                    <td>
                                        @{
                                            var status = GetStatusDisplay(variant.isActive, variant.TotalStock);
                                        }
                                        <span class="badge @status.Class">@status.Text</span>
                                    </td>
                                    <td class="text-end">
                                        <button type="button" 
                                                class="btn btn-sm btn-outline-primary me-1" 
                                                data-bs-toggle="modal" 
                                                data-bs-target="#editVariantModal"
                                                data-variant-id="@variant.Id"
                                                data-variant-color="@variant.Color"
                                                data-variant-size="@variant.Size"
                                                data-variant-status="@variant.isActive"
                                                data-variant-images='@Html.Raw(
                                                    Json.Serialize(
                                                        variant.Images.Select(img => new { img.Id, img.RelativePath })
                                                    )
                                                )'
                                                data-variant-price="@(variant.OverridePrice?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))"
                                                title="Редактировать">
                                            ✏️ 
                                        </button>

                                        <a href="@Url.Action("Stock", "Products", new { variantId = variant.Id, area = "Admin" })" 
                                           class="btn btn-sm btn-outline-info" title="Остатки">
                                            📦
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-warning">⚠️ Вариантов не найдено</div>
            }

            <hr class="my-4" />

            <!-- ФОРМА ДОБАВЛЕНИЯ ВАРИАНТА -->
            <h5 class="mb-3">➕ Добавить новый вариант</h5>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form method="post" asp-action="CreateVariant" enctype="multipart/form-data" class="card p-4">
                <input type="hidden" name="productId" value="@Model.ProductId" />

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Цвет <span class="text-danger">*</span></label>
                        <input type="text" name="form.Color" class="form-control" placeholder="Артисан" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Размер</label>
                        <input type="text" name="form.Size" class="form-control" placeholder="19х64" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Своя цена</label>
                        <div class="input-group">
                            <input type="number" name="form.OverridePrice" class="form-control" step="0.01" min="0.01" placeholder=@Model.BasePrice.ToString("0.00") />
                            <span class="input-group-text">@CurrencyHelper.DefaultCurrency</span>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Изображения</label>
                    <div id="imagePreview" class="mb-2"></div>
                    <input type="file" name="form.Images" class="form-control" multiple accept=".jpg,.jpeg,.png,.webp" id="variantImageInput" />
                    <small class="text-muted">JPG, PNG, WebP.  Макс. 5 МБ за файл.  Выбирайте ВСЕ сразу! </small>
                </div>

                <button type="submit" class="btn btn-success">✅ Добавить вариант</button>
            </form>
        </main>
    </div>
</div>










<!-- Modal Structure -->
<div class="modal fade" id="editVariantModal" tabindex="-1" aria-labelledby="editVariantModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="UpdateVariant" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title" id="editVariantModalLabel">Редактировать вариант</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Скрытые поля для ID -->
                    <input type="hidden" name="variantId" id="modalVariantId" />
                    <input type="hidden" name="productId" value="@Model.ProductId" />
                    
                    <!-- Контейнер для ID удаляемых картинок -->
                    <div id="deleteImagesHiddenInputs"></div>

                    <!-- Поля формы -->
                    <div class="mb-3">
                        <label for="modalColor" class="form-label">Цвет <span class="text-danger">*</span></label>
                        <input type="text" name="form.Color" id="modalColor" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label for="modalSize" class="form-label">Размер</label>
                        <input type="text" name="form.Size" id="modalSize" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label for="modalPrice" class="form-label">Своя цена</label>
                        <div class="input-group">
                            <input type="number" name="form.OverridePrice" id="modalPrice" class="form-control" step="0.01" placeholder="Оставить пустым" />
                            <span class="input-group-text">@Store.Application.Utilities.CurrencyHelper.DefaultCurrency</span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label d-block">Статус</label>

                        

                        <div class="form-check form-switch">
                            <input class="form-check-input"
                                type="checkbox"
                                id="modalIsActive"
                                name="form.IsActive"
                                value="true" />

                            <label class="form-check-label" for="modalIsActive" id="modalIsActiveLabel">
                                Активен
                            </label>
                        </div>

                        <input type="hidden" name="form.IsActive" value="false" />
                    </div>


                    <!-- Текущие изображения -->
                    <div class="mb-3">
                        <label class="form-label">Текущие изображения</label>
                        <div id="existingImagesContainer" class="d-flex flex-wrap gap-2 mb-2">
                            <!-- Генерируется через JS -->
                        </div>
                    </div>

                    <!-- Добавление новых изображений -->
                    <div class="mb-3">
                        <label class="form-label">Добавить новые фото</label>
                        <div id="modalImagePreview" class="mb-2 d-flex flex-wrap gap-2"></div>
                        <input type="file" name="form.Images" class="form-control" multiple accept=".jpg,.jpeg,.png,.webp" id="modalVariantImageInput" />
                        <small class="text-muted">Новые фото добавятся к текущим.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-primary">✅ Сохранить изменения</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        /**
         * 1. ФУНКЦИИ ПРЕДПРОСМОТРА
         */
        function setupPreview(inputElement, previewElement) {
            inputElement?.addEventListener('change', function (e) {
                previewElement.innerHTML = '';
                Array.from(e.target.files).forEach(file => {
                    const reader = new FileReader();
                    reader.onload = function (event) {
                        const div = document.createElement('div');
                        div.className = 'position-relative d-inline-block me-2 mb-2';
                        div.innerHTML = `
                            <img src="${event.target.result}" style="width: 80px; height: 80px; object-fit: cover; border-radius: 4px; border: 1px solid #dee2e6;">
                            <small class="d-block text-muted text-truncate" style="max-width: 80px;">${file.name}</small>`;
                        previewElement.appendChild(div);
                    };
                    reader.readAsDataURL(file);
                });
            });
        }

        // Инициализация предпросмотра для обеих форм
        setupPreview(document.getElementById('variantImageInput'), document.getElementById('imagePreview'));
        setupPreview(document.getElementById('modalVariantImageInput'), document.getElementById('modalImagePreview'));

        /**
         * 2. ЛОГИКА УДАЛЕНИЯ (МАРКИРОВКА)
         */
        function markImageForDeletion(imageId) {
            // Скрываем элемент в модалке
            const wrapper = document.getElementById(`img-wrapper-${imageId}`);
            if (wrapper) wrapper.remove();

            // Создаем скрытый input для отправки на сервер
            const container = document.getElementById('deleteImagesHiddenInputs');
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'form.ImagesToDelete'; // Должно совпадать с именем в ViewModel
            input.value = imageId;
            container.appendChild(input);
        }

        /**
         * 3. ЗАПОЛНЕНИЕ МОДАЛЬНОГО ОКНА ПРИ ОТКРЫТИИ
         */
        const editVariantModal = document.getElementById('editVariantModal');
        editVariantModal?.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            
            // Чистим старые данные
            document.getElementById('deleteImagesHiddenInputs').innerHTML = '';
            document.getElementById('modalImagePreview').innerHTML = '';
            document.getElementById('modalVariantImageInput').value = '';

            // Основные поля
            document.getElementById('modalVariantId').value = button.getAttribute('data-variant-id');
            document.getElementById('modalColor').value = button.getAttribute('data-variant-color');
            const size = button.getAttribute('data-variant-size');
            document.getElementById('modalSize').value = (size && size !== '—') ? size : '';
            document.getElementById('modalPrice').value = button.getAttribute('data-variant-price');

            
            




            const isActive = button.getAttribute('data-variant-status') === 'True'
              || button.getAttribute('data-variant-status') === 'true';

            const checkbox = document.getElementById('modalIsActive');
            checkbox.checked = isActive;



            const label = document.getElementById('modalIsActiveLabel');
            label.textContent = isActive ? 'Активен' : 'Скрыт';

            // обновление текста при клике
            checkbox.onchange = () => {
                label.textContent = checkbox.checked ? 'Активен' : 'Скрыт';
            };







            // Отрисовка текущих изображений
            const imagesJson = button.getAttribute('data-variant-images');
            const container = document.getElementById('existingImagesContainer');
            container.innerHTML = '';

            if (imagesJson) {
                const images = JSON.parse(imagesJson);
                images.forEach(img => {
                    const div = document.createElement('div');
                    div.className = 'position-relative d-inline-block';
                    div.id = `img-wrapper-${img.id}`;
                    div.innerHTML = `
                        <img src="${img.relativePath}" style="width: 80px; height: 80px; object-fit: cover; border-radius: 4px; border: 1px solid #dee2e6;">
                        <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 p-0" 
                                style="width: 20px; height: 20px; font-size: 14px; line-height: 1;"
                                onclick="markImageForDeletion(${img.id})">
                            &times;
                        </button>`;
                    container.appendChild(div);
                });
            }
        });
    </script>
}
