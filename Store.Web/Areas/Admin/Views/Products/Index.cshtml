@model IReadOnlyList<Store.Web.Areas.Admin.ViewModels.ProductListItemViewModel>

@{
    ViewData["Title"] = "Товары";
    (string Text, string Class) GetStatusDisplay(bool IsActive, int stock) => (IsActive, stock) switch
    {
        (false, _) => ("Скрыт", "bg-danger"),
        (true, 0) => ("Нет в наличии", "bg-warning text-dark"),
        (true, > 0) => ("Активен", "bg-success"),
        _ => ("Неизвестно", "bg-secondary")
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Товары</h1>

    <a asp-action="Create" class="btn btn-primary">
        Добавить товар
    </a>
</div>

<table class="table table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th></th>
            <th>#</th>
            <th>Название</th>
            <th>Категория</th>
            <th>Цена</th>
            <th>Статус</th>
            <th class="text-end">Действия</th>
        </tr>
    </thead>
    <tbody>
    @if (!Model.Any())
    {
        <tr>
            <td colspan="6" class="text-center text-muted py-4">
                Товары не найдены
            </td>
        </tr>
    }
    else
    {
        int i = 0;
        foreach (var item in Model)
        {
            i += 1;
            <tr>
                <td>@i</td>
                <td>@item.Id</td>
                <td>
                    <strong>@item.Name</strong>
                </td>
                <td>@item.Category</td>
                <td>
                    @item.Price.ToString("0.00")
                </td>
                <td>
                    @{
                        var status = GetStatusDisplay(item.IsActive, item.TotalStock);
                    }
                    <span class="badge @status.Class">@status.Text</span>
                </td>
                <td class="text-end">
                    <div class="btn-group btn-group-sm">
                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-outline-primary">
                            Редактировать
                        </a>

                        <a asp-action="Variants"
                           asp-route-id="@item.Id"
                           class="btn btn-outline-secondary">
                            Варианты
                        </a>
                    </div>
                </td>
            </tr>
        }
    }
    </tbody>
</table>
