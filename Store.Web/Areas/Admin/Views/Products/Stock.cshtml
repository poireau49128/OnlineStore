@model Store.Web.Areas.Admin.ViewModels.StockViewModel
@using Store.Application.Utilities

@{
    ViewData["Title"] = "Остатки варианта";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <partial name="_AdminSidebar" />
        <main class="col">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1>Остатки варианта</h1>
                    <p class="text-muted mb-0">
                        <strong>@Model.ProductName</strong> — @Model.VariantDescription
                    </p>
                </div>
                <a href="@Url.Action("Variants", "Products", new { id = Model.ProductId, area = "Admin" })" 
                   class="btn btn-secondary">← Назад</a>
            </div>

            <!-- NOTIFICATIONS -->
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (Model.Stocks.Any())
            {
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="mb-0">Текущие остатки</h6>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Склад</th>
                                    <th>Количество</th>
                                    <th class="text-end">Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var stock in Model.Stocks)
                                {
                                    <tr>
                                        <td><strong>@stock.WarehouseName</strong></td>
                                        <td><span class="badge bg-primary">@stock.Quantity шт</span></td>
                                        <td class="text-end">
                                            <form method="post" asp-action="RemoveStock" style="display: inline;">
                                                <input type="hidden" name="stockId" value="@stock.StockId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" 
                                                        onclick="return confirm('Удалить? ')">
                                                    🗑️
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-4">Остатки ещё не добавлены</div>
            }

            <hr class="my-4" />

            <h5 class="mb-3">Добавить / Обновить остаток</h5>

            <form method="post" asp-action="UpdateStock" class="card p-4">
                <input type="hidden" name="variantId" value="@Model.VariantId" />

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label for="warehouseSelect" class="form-label">Склад <span class="text-danger">*</span></label>
                        <select id="warehouseSelect" name="WarehouseId" class="form-select" required>
                            <option value="">-- Выберите склад --</option>
                            @foreach (var warehouse in Model.Warehouses)
                            {
                                var currentStock = Model.Stocks.FirstOrDefault(s => s.WarehouseId == warehouse.Id);
                                <option value="@warehouse.Id" data-current="@(currentStock?.Quantity ?? 0)">
                                    @warehouse.Name
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label for="quantityInput" class="form-label">Количество (шт) <span class="text-danger">*</span></label>
                        <input type="number" id="quantityInput" name="Quantity" 
                               class="form-control" value="0" min="0" required />
                        <small class="text-muted" id="currentStockInfo"></small>
                    </div>
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <a href="@Url.Action("Variants", "Products", new { id = Model.ProductId, area = "Admin" })" 
                       class="btn btn-secondary">Отмена</a>
                    <button type="submit" class="btn btn-success">Сохранить остаток</button>
                </div>
            </form>
        </main>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('warehouseSelect')?.addEventListener('change', function() {
            const currentQty = this.options[this.selectedIndex]?.dataset.current || '0';
            const info = document.getElementById('currentStockInfo');
            const quantityInput = document.getElementById('quantityInput');
            
            if (this.value) {
                info.textContent = `Текущий остаток: ${currentQty} шт`;
                quantityInput.value = currentQty;
            } else {
                info.textContent = '';
                quantityInput.value = '0';
            }
        });
    </script>
}