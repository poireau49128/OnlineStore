@using Store.Domain.Enums
@model AdminOrderDetailsDto

@{
    Layout = "_Layout";
    ViewData["Title"] = $"Заказ №{Model.Id}";
}

<div class="container-fluid">
    <div class="row">
        <partial name="_AdminSidebar" />
        <main class="col">
            <h2>Заказ №@Model.Id</h2>

            <p>
                <strong>Пользователь:</strong> @Model.UserEmail<br />
                <strong>Дата:</strong> @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")<br />
                <strong>Статус:</strong> <span id="status-text">@Model.Status.ToUserText()</span><br />
                <strong>Сумма:</strong> @Model.TotalPrice.Amount.ToString("0.00") @Model.TotalPrice.Currency
            </p>

            <form id="change-status-form" method="post" action="/Admin/Orders/ChangeStatus">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                <select name="status" class="form-select w-auto d-inline" id="status-select">
                    @{
                        // текущий статус первым
                        <option value="@Model.Status" selected>@Model.Status.ToUserText()</option>

                        // разрешённые следующие статусы
                        foreach (var s in OrderStatusRules.GetAllowedNext(Model.Status))
                        {
                            <option value="@s">@s.ToUserText()</option>
                        }
                    }
                </select>

                <button class="btn btn-success btn-sm ms-2">
                    Сохранить
                </button>
            </form>

            <table class="table table-striped mt-4">
                <thead>
                <tr>
                    <th>Товар</th>
                    <th>Кол-во</th>
                    <th>Цена</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td>@item.Quantity</td>
                        <td>@item.Price</td>
                    </tr>
                }
                </tbody>
            </table>

            <a href="/Admin/Orders" class="btn btn-secondary">← Назад</a>
        </main>
    </div>
</div>

@section Scripts {
    <script>
        handleAjaxForm('#change-status-form', function(data) {
            const statusText = document.getElementById('status-text');
            const statusSelect = document.getElementById('status-select');

            statusText.textContent = data.status;

            statusSelect.innerHTML = '';
            const optionCurrent = document.createElement('option');
            optionCurrent.value = data.statusEnum;
            optionCurrent.text = data.status;
            optionCurrent.selected = true;
            statusSelect.appendChild(optionCurrent);

            if (data.allowedNextStatuses) {
                data.allowedNextStatuses.forEach(s => {
                    const option = document.createElement('option');
                    option.value = s.value;
                    option.text = s.text;
                    statusSelect.appendChild(option);
                });
            }
        });
    </script>
}
