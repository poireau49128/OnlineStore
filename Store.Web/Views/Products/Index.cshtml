@model IEnumerable<Store.Domain.Entities.Product>
@{
    ViewData["Title"] = "Products";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<h2 class="mb-4">Каталог товаров</h2>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var product in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                @if (product.Images.Any())
                {
                    <img src="@product.Images.First().RelativePath" class="card-img-top" alt="@product.Name">
                }
                else
                {
                    <img src="https://via.placeholder.com/300x200?text=No+Image" class="card-img-top" alt="No image">
                }
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@product.Name</h5>
                    <p class="card-text text-muted">@product.Category?.ProductType?.Name / @product.Category?.Name</p>
                    <p class="card-text fw-bold">@product.BasePrice.Amount @product.BasePrice.Currency</p>
                    <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-primary mt-auto">Подробнее</a>
                </div>
            </div>
        </div>
    }
</div>

<!-- Пагинация -->
<nav aria-label="Page navigation" class="mt-4">
    <ul class="pagination justify-content-center">
        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)">Previous</a>
        </li>
        @for (int i = 1; i <= totalPages; i++)
        {
            <li class="page-item @(i == currentPage ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
            </li>
        }
        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)">Next</a>
        </li>
    </ul>
</nav>
