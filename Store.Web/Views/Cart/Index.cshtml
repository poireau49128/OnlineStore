@model Store.Web.ViewModels.Cart.CartViewModel

<div class="container mt-5">

<h2 class="mb-4" style="color:#1F3A8A;">Корзина</h2>

@if (!Model.Items.Any())
{
    <div class="empty-cart-box">
        <p>Ваша корзина пуста</p>
        <a asp-controller="Product"
           asp-action="Index"
           class="btn btn-primary mt-3">
            Перейти в каталог
        </a>
    </div>
}
else
{
    <div class="table-responsive cart-table-wrapper">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Товар</th>
                    <th>Склад</th>
                    <th>Кол-во</th>
                    <th>Цена</th>
                    <th>Сумма</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr class="cart-item" data-item-id="@item.Id">
                        <td>
                            <div class="fw-semibold">@item.ProductName</div>
                            <div class="text-muted small">
                                @item.Color @(!string.IsNullOrEmpty(item.Size) ? $"({item.Size})" : "")
                            </div>
                        </td>

                        <td>@item.WarehouseName</td>

                        <td>
                            <div class="input-group">
                                <button class="btn btn-sm btn-outline-secondary qty-minus"
                                        type="button"
                                        data-item-id="@item.Id"
                                        @(item.Quantity <= 1 ? "disabled" : "")>−</button>

                                <input type="text"
                                       class="form-control text-center qty-input"
                                       value="@item.Quantity"
                                       readonly>

                                <button class="btn btn-sm btn-outline-secondary qty-plus"
                                        type="button"
                                        data-item-id="@item.Id"
                                        data-max="@item.AvailableQuantity"
                                        @(item.Quantity >= item.AvailableQuantity ? "disabled" : "")>+</button>
                            </div>
                        </td>

                        <td>@item.UnitPrice.Amount.ToString("0.00") @item.UnitPrice.Currency</td>

                        <td class="total-price"
                            data-total="@(item.Quantity * item.UnitPrice.Amount)">
                            @(item.Quantity * item.UnitPrice.Amount) @item.UnitPrice.Currency
                        </td>

                        <td>
                            <button class="btn btn-sm btn-outline-danger btn-remove"
                                    type="button"
                                    data-item-id="@item.Id">
                                Удалить
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="row mt-5">
        <div class="col-md-7">
            <a asp-controller="Product"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Продолжить покупки
            </a>
        </div>

        <div class="col-md-5">
            <div class="cart-summary-card">
                <h5>Сумма заказа</h5>
                <h3 id="total-amount">
                    @Model.Total.Amount.ToString("0.00") @Model.Total.Currency
                </h3>
                <a asp-controller="Order"
                   asp-action="Checkout"
                   class="btn btn-success w-100 mt-3">
                    Оформить заказ
                </a>
            </div>
        </div>
    </div>
}

</div>

<style>
.cart-table-wrapper {
    background:white;
    border-radius:20px;
    padding:30px;
    box-shadow:0 15px 40px rgba(0,0,0,0.06);
}

.cart-summary-card {
    background:white;
    border-radius:20px;
    padding:30px;
    box-shadow:0 15px 40px rgba(0,0,0,0.06);
}

.empty-cart-box {
    background:white;
    padding:60px;
    border-radius:20px;
    text-align:center;
    box-shadow:0 15px 40px rgba(0,0,0,0.05);
}
</style>

@Html.AntiForgeryToken()

@section Scripts {
<script>
    function getCsrfToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    }

    function showNotification(message, type = "info") {
        const alertDiv = document.createElement("div");
        alertDiv.className = `alert alert-${type} alert-notification alert-dismissible fade show`;
        alertDiv.role = "alert";
        alertDiv.innerHTML = `
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        document.body.appendChild(alertDiv);
        setTimeout(() => alertDiv.parentNode && alertDiv.remove(), 4000);
    }

    async function updateCartQuantity(itemId, newQuantity) {
        const formData = new FormData();
        formData.append('id', itemId);
        formData.append('quantity', newQuantity);
        formData.append('__RequestVerificationToken', getCsrfToken());

        try {
            const response = await fetch('/Cart/Update', {
                method: 'POST',
                body: formData
            });

            const data = await response.json();

            if (data.success) {
                const row = document.querySelector(`tr.cart-item[data-item-id="${itemId}"]`);
                if (row) {
                    const qtyInput = row.querySelector('.qty-input');
                    const totalPrice = row.querySelector('.total-price');
                    const qtyMinus = row.querySelector('.qty-minus');
                    const qtyPlus = row.querySelector('.qty-plus');

                    qtyInput.value = data.item.quantity;
                    totalPrice.textContent = `${data.item.totalPrice.toFixed(2)} ${data.currency}`;

                    qtyMinus.disabled = data.item.quantity <= 1;
                    qtyPlus.disabled = data.item.quantity >= data.item.availableQuantity;
                }

                document.getElementById('total-amount').textContent = `${data.totalAmount.toFixed(2)} ${data.currency}`;
                updateCartBadge();
                showNotification(data.message, "success");
            } else {
                showNotification(data.message || "Ошибка при обновлении", "danger");
            }
        } catch (error) {
            console.error('Error:', error);
            showNotification("❌ Ошибка при обновлении:  " + error.message, "danger");
        }
    }

    async function removeCartItem(itemId) {
        if (! confirm('Вы уверены, что хотите удалить товар? ')) return;

        const formData = new FormData();
        formData.append('id', itemId);
        formData.append('__RequestVerificationToken', getCsrfToken());

        try {
            const response = await fetch('/Cart/Remove', {
                method: 'POST',
                body: formData
            });

            const data = await response.json();

            if (data.success) {
                const row = document.querySelector(`tr.cart-item[data-item-id="${itemId}"]`);
                if (row) {
                    row.style.animation = 'fadeOut 0.3s ease-out';
                    setTimeout(() => row.remove(), 300);
                }

                const tableBody = document.querySelector('table tbody');
                if (!tableBody || tableBody.children.length === 0) {
                    setTimeout(() => location.reload(), 500);
                }

                document.getElementById('total-amount').textContent = `${data.totalAmount.toFixed(2)} ${data.currency}`;
                updateCartBadge();
                showNotification(data.message, "success");
            } else {
                showNotification(data.message || "Ошибка при удалении", "danger");
            }
        } catch (error) {
            console.error('Error:', error);
            showNotification("❌ Ошибка при удалении: " + error.message, "danger");
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.qty-minus').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const itemId = parseInt(e.target.dataset.itemId);
                const row = document.querySelector(`tr.cart-item[data-item-id="${itemId}"]`);
                const currentQty = parseInt(row.querySelector('.qty-input').value);
                if (currentQty > 1) {
                    updateCartQuantity(itemId, currentQty - 1);
                }
            });
        });

        document.querySelectorAll('.qty-plus').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const itemId = parseInt(e.target.dataset.itemId);
                const maxQty = parseInt(e.target.dataset.max);
                const row = document.querySelector(`tr.cart-item[data-item-id="${itemId}"]`);
                const currentQty = parseInt(row.querySelector('.qty-input').value);
                if (currentQty < maxQty) {
                    updateCartQuantity(itemId, currentQty + 1);
                }
            });
        });

        document.querySelectorAll('.btn-remove').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const itemId = parseInt(e.target.dataset.itemId);
                removeCartItem(itemId);
            });
        });
    });
</script>
}