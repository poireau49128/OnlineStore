@model Store.Web.ViewModels.Cart.CartViewModel

<style>
    .cart-card {
        background: white;
        border-radius: 18px;
        padding: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        transition: .3s;
    }

    .cart-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 50px rgba(0,0,0,0.08);
    }

    .cart-card-body {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    /* LEFT */
    .cart-info {
        flex: 1;
    }

    .cart-meta {
        font-size: 0.85rem;
        color: #64748B;
    }

    /* CENTER */
    .cart-qty {
        width: 140px;
    }

    /* RIGHT */
    .cart-prices {
        text-align: right;
        min-width: 120px;
    }

    .cart-prices .price {
        font-size: 0.9rem;
        color: #64748B;
    }

    .cart-prices .total-price {
        font-weight: 600;
        color: #1F3A8A;
    }

    /* REMOVE */
    .cart-remove {
        margin-left: 10px;
    }

    /* SUMMARY */
    .sticky-summary {
        position: sticky;
        top: 100px;
    }

    /* MOBILE 🔥 */
    @@media (max-width: 768px) {

        .cart-card-body {
            flex-direction: column;
            align-items: flex-start;
        }

        .cart-qty {
            width: 100%;
        }

        .cart-prices {
            width: 100%;
            display: flex;
            justify-content: space-between;
        }

        .cart-remove {
            align-self: flex-end;
        }
    }
</style>

<div class="container mt-5">

<h2 class="mb-4" style="color:#1F3A8A;">Корзина</h2>

@if (!Model.Items.Any())
{
    <div class="empty-cart-box">
        <p>Ваша корзина пуста</p>
        <a asp-controller="Product" asp-action="Index" class="btn-cart-primary mt-3">
            Перейти в каталог
        </a>
    </div>
}
else
{
    <div class="row g-4">

        <!-- ITEMS -->
        <div class="col-lg-8">

            @foreach (var item in Model.Items)
            {
                <div class="cart-card" data-item-id="@item.Id">

                    <div class="cart-card-body">

                        <!-- LEFT -->
                        <div class="cart-info">
                            <div class="fw-semibold">@item.ProductName</div>

                            <div class="cart-meta">
                                @item.Color
                                @if (!string.IsNullOrEmpty(item.Size))
                                {
                                    <span>(@item.Size)</span>
                                }
                            </div>

                            <div class="cart-meta small text-muted">
                                Склад: @item.WarehouseName
                            </div>
                        </div>

                        <!-- CENTER -->
                        <div class="cart-qty">

                            <div class="input-group">
                                <button class="btn btn-sm btn-outline-secondary qty-minus"
                                        type="button"
                                        data-item-id="@item.Id"
                                        @(item.Quantity <= 1 ? "disabled" : "")>−</button>

                                <input type="text"
                                       class="form-control text-center qty-input"
                                       value="@item.Quantity"
                                       readonly>

                                <button class="btn btn-sm btn-outline-secondary qty-plus"
                                        type="button"
                                        data-item-id="@item.Id"
                                        data-max="@item.AvailableQuantity"
                                        @(item.Quantity >= item.AvailableQuantity ? "disabled" : "")>+</button>
                            </div>

                        </div>

                        <!-- RIGHT -->
                        <div class="cart-prices">

                            <div class="price">
                                @item.UnitPrice.Amount.ToString("0.00") @item.UnitPrice.Currency
                            </div>

                            <div class="total-price"
                                 data-total="@(item.Quantity * item.UnitPrice.Amount)">
                                @(item.Quantity * item.UnitPrice.Amount) @item.UnitPrice.Currency
                            </div>

                        </div>

                        <!-- REMOVE -->
                        <div class="cart-remove">
                            <button class="btn-cart-danger btn-remove"
                                    type="button"
                                    data-item-id="@item.Id">
                                ✕
                            </button>
                        </div>

                    </div>

                </div>
            }

        </div>

        <!-- SUMMARY -->
        <div class="col-lg-4">

            <div class="cart-summary-card sticky-summary">
                <h5>Сумма заказа</h5>

                <h3 id="total-amount">
                    @Model.Total.Amount.ToString("0.00") @Model.Total.Currency
                </h3>

                <a asp-controller="Order" asp-action="Checkout" class="btn-cart-primary mt-3">
                    Оформить заказ
                </a>

                <a asp-controller="Product" asp-action="Index" class="btn-cart-outline mt-2">
                    Продолжить покупки
                </a>
            </div>

        </div>

    </div>
}

</div>



@Html.AntiForgeryToken()
@section Scripts {
<script>
    function getCsrfToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    }

    function showNotification(message, type = "info") {
        const container = document.getElementById("toast-container");
        if (!container) { console.error("Toast container not found"); return; }
        const icons = { success: "✓", danger: "✕", warning: "⚠", info: "ℹ" };
        const alertDiv = document.createElement("div");
        alertDiv.className = `alert alert-${type} alert-notification alert-dismissible fade show`;
        alertDiv.innerHTML = `
            <div class="d-flex align-items-center">
                <span class="me-2 fw-bold" style="font-size:1.1rem;">${icons[type] || icons.info}</span>
                <span class="flex-grow-1">${message}</span>
                <button type="button" class="btn-close btn-close-white ms-2" data-bs-dismiss="alert" style="font-size:0.6rem; padding:0.4rem;"></button>
            </div>`;
        container.appendChild(alertDiv);
        setTimeout(() => {
            alertDiv.classList.remove("show");
            alertDiv.style.transition = "all 0.3s ease";
            alertDiv.style.opacity = "0";
            alertDiv.style.transform = "translateX(120%)";
            setTimeout(() => alertDiv.remove(), 300);
        }, 4000);
        alertDiv.querySelector(".btn-close").addEventListener("click", () => alertDiv.remove());
    }

    async function updateCartQuantity(itemId, newQuantity) {
        const formData = new FormData();
        formData.append('id', itemId);
        formData.append('quantity', newQuantity);
        formData.append('__RequestVerificationToken', getCsrfToken());

        try {
            const response = await fetch('/Cart/Update', {
                method: 'POST',
                body: formData
            });

            const data = await response.json();

            if (data.success) {
                const row = document.querySelector(`.cart-card[data-item-id="${itemId}"]`);
                if (row) {
                    const qtyInput = row.querySelector('.qty-input');
                    const totalPrice = row.querySelector('.total-price');
                    const qtyMinus = row.querySelector('.qty-minus');
                    const qtyPlus = row.querySelector('.qty-plus');

                    qtyInput.value = data.item.quantity;
                    totalPrice.textContent = `${data.item.totalPrice.toFixed(2)} ${data.currency}`;

                    qtyMinus.disabled = data.item.quantity <= 1;
                    qtyPlus.disabled = data.item.quantity >= data.item.availableQuantity;
                }

                document.getElementById('total-amount').textContent = `${data.totalAmount.toFixed(2)} ${data.currency}`;
                updateCartBadge();
                showNotification(data.message, "success");
            } else {
                showNotification(data.message || "Ошибка при обновлении", "danger");
            }
        } catch (error) {
            console.error('Error:', error);
            showNotification("❌ Ошибка при обновлении:  " + error.message, "danger");
        }
    }

    async function removeCartItem(itemId) {
        @* if (! confirm('Вы уверены, что хотите удалить товар? ')) return; *@

        const formData = new FormData();
        formData.append('id', itemId);
        formData.append('__RequestVerificationToken', getCsrfToken());

        try {
            const response = await fetch('/Cart/Remove', {
                method: 'POST',
                body: formData
            });

            const data = await response.json();

            if (data.success) {
                const row = document.querySelector(`.cart-card[data-item-id="${itemId}"]`);
                if (row) {
                    row.style.animation = 'fadeOut 0.3s ease-out';
                    setTimeout(() => row.remove(), 300);
                }

                const tableBody = document.querySelector('table tbody');
                if (!tableBody || tableBody.children.length === 0) {
                    setTimeout(() => location.reload(), 500);
                }

                document.getElementById('total-amount').textContent = `${data.totalAmount.toFixed(2)} ${data.currency}`;
                updateCartBadge();
                showNotification(data.message, "success");
            } else {
                showNotification(data.message || "Ошибка при удалении", "danger");
            }
        } catch (error) {
            console.error('Error:', error);
            showNotification("❌ Ошибка при удалении: " + error.message, "danger");
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.qty-minus').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const itemId = parseInt(e.target.dataset.itemId);
                const row = document.querySelector(`.cart-card[data-item-id="${itemId}"]`);
                const currentQty = parseInt(row.querySelector('.qty-input').value);
                if (currentQty > 1) {
                    updateCartQuantity(itemId, currentQty - 1);
                }
            });
        });

        document.querySelectorAll('.qty-plus').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const itemId = parseInt(e.target.dataset.itemId);
                const maxQty = parseInt(e.target.dataset.max);
                const row = document.querySelector(`.cart-card[data-item-id="${itemId}"]`);
                const currentQty = parseInt(row.querySelector('.qty-input').value);
                if (currentQty < maxQty) {
                    updateCartQuantity(itemId, currentQty + 1);
                }
            });
        });

        document.querySelectorAll('.btn-remove').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const itemId = parseInt(e.target.dataset.itemId);
                removeCartItem(itemId);
            });
        });
    });
</script>
}