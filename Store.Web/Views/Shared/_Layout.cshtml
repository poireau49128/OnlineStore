<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Store</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">Store</a>
        </div>
    </nav>
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-2 bg-light p-3">
                <!-- Боковое меню -->
                <h5>Категории</h5>
                <ul class="list-group">
                    <li class="list-group-item"><a href="#">Все</a></li>
                    <li class="list-group-item"><a href="#">Электроника</a></li>
                    <li class="list-group-item"><a href="#">Одежда</a></li>
                    <li class="list-group-item"><a href="#">Дом</a></li>
                </ul>
            </div>
            <div class="col-md-10 p-3">
                @RenderBody()
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
