    <h1 class="h1-header">ФАСАДЫ РАМОЧНЫЕ И ДЕКОРАТИВНЫЕ ЭЛЕМЕНТЫ ДЛЯ МЕБЕЛИ И ИНТЕРЬЕРА</h1>
    <div class="categories">
        <div class="category">
            <a href="/Product/Index?productType=fasady-dlya-kuhni">
                <div class="cat-image">
                    <img src="~/img/fronts.jpg" alt="Фасады" />
                </div>
                <h3>Фасады</h3>
