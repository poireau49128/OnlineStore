            <div class="sup-logo logo-3"><img src="~/img/sup-3.png" alt="Поставщик 3" /></div>
            <div class="sup-logo logo-4"><img src="~/img/sup-4.png" alt="Поставщик 4" /></div>
            <div class="sup-logo logo-5"><img src="~/img/sup-5.png" alt="Поставщик 5" /></div>
            <div class="sup-logo logo-6"><img src="~/img/sup-6.png" alt="Поставщик 6" /></div>
            <div class="sup-logo logo-7"><img src="~/img/sup-7.png" alt="Поставщик 7" /></div>
