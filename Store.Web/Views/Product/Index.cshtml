@model Store.Web.ViewModels.Product.ProductCatalogViewModel

@{
    ViewData["Title"] = "Каталог товаров";
}

<style>
.catalog-sidebar .btn-primary {
    background-color: #64998C !important;
    border-color: #64998C !important;
    transition: all 0.3s ease;
}

.catalog-sidebar .btn-primary:hover {
    background-color: #4f7a70 !important;
    border-color: #4f7a70 !important;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(100, 153, 140, 0.3);
}

.catalog-sidebar .accordion-button {
    font-size: 13px;
    font-weight: 500;
    color: #333;
    border-radius: 10px !important;
    transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    padding: 12px 16px;
}

.catalog-sidebar .accordion-button:hover {
    background-color: rgba(100, 153, 140, 0.08);
    padding-left: 2px;
    color: #07604E;
}

.catalog-sidebar .accordion-button:not(.collapsed) {
    background-color: rgba(100, 153, 140, 0.12);
    color: #07604E;
    font-weight: 600;
    box-shadow: none;
}

.catalog-sidebar .accordion-item {
    border-radius: 10px;
    margin-bottom: 6px;
    background: transparent;
}

.filter-link {
    display: block;
    padding: 8px 14px;
    margin: 3px 0;
    border-radius: 8px;
    color: #555;
    font-size: 13px;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
    position: relative;
}

.filter-link:hover {
    background-color: rgba(100, 153, 140, 0.1);
    color: #07604E;
    padding-left: 20px;
}

.filter-link.active {
    background-color: rgba(100, 153, 140, 0.15);
    color: #07604E;
    font-weight: 600;
}

.sidebar-title {
    font-size: 16px;
    font-weight: 600;
    color: #07604E;
    margin-bottom: 16px;
    padding-bottom: 10px;
    border-bottom: 2px solid rgba(100, 153, 140, 0.2);
}
</style>

<div class="container">

    

    <div class="row g-5 mt-4">
        <div class="col-lg-3">
            <div class="catalog-sidebar">

                <h6 class="sidebar-title">Фильтры</h6>

                <form method="get" class="mb-4">
                    <div class="input-group">
                        <input type="text"
                            name="searchTerm"
                            class="form-control"
                            placeholder="Поиск..."
                            value="@Model.SearchTerm" />
                        <button class="btn btn-primary">Найти</button>
                    </div>
                </form>

                <a href="@Url.Action("Index", "Product")"
                class="filter-link @(Model.SelectedCategoryId == null && string.IsNullOrEmpty(Model.SelectedProductType) ? "active" : "")">
                    Все товары
                </a>

                <div class="type-list mt-3">
                    @foreach (var group in Model.CategoryGroups)
                    {
                        var collapseId = $"type-{group.ProductTypeId}";
                        var isExpanded = group.Categories.Any(c => c.Id == Model.SelectedCategoryId);

                        <div class="type-group">
                            <div class="type-header">
                                <a href="@Url.Action("Index", "Product", new { productType = group.ProductTypeSlug })"
                                class="type-link @(Model.SelectedProductType == group.ProductTypeSlug ? "active" : "")">
                                    @group.ProductTypeName
                                </a>
                                <button class="toggle-btn @(isExpanded ? "" : "collapsed")" 
                                        type="button"
                                        data-bs-toggle="collapse" 
                                        data-bs-target="#@collapseId"
                                        aria-expanded="@(isExpanded ? "true" : "false")">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M6 9l6 6 6-6"/>
                                    </svg>
                                </button>
                            </div>

                            <div id="@collapseId"
                                class="collapse @(isExpanded ? "show" : "")">
                                <div class="type-categories">
                                    @foreach (var category in group.Categories)
                                    {
                                        <a href="@Url.Action("Index", "Product", new { categoryId = category.Id, page = 1 })"
                                        class="filter-link @(Model.SelectedCategoryId == category.Id ? "active" : "")">
                                            @category.Name
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

            </div>
        </div>

        <div class="col-lg-9">

            <div class="row g-4">
                @foreach (var product in Model.Products)
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="product-card-modern">

                            <div class="product-image-modern">
                                <img src="@ToThumb(Url.Content(product.ImagePath))"
                                     class="fade-img"
                                     loading="lazy"
                                     onload="this.classList.add('loaded')"
                                     alt="@product.Name">
                            </div>

                            <div class="product-info-modern">
                                <h6>@product.Name</h6>
                                <span class="category-label">@product.CategoryName</span>

                                <div class="price-row">
                                    <div class="price">
                                        @($"{product.Price?.Amount ?? 0:0.00} {product.Price?.Currency ?? "BYN"}")
                                    </div>

                                    <a href="@Url.Action("Details", "Product", new { id = product.Id })"
                                       class="details-btn">
                                        Подробнее
                                    </a>
                                </div>
                            </div>

                        </div>
                    </div>
                }
            </div>

        </div>

        @if (Model.Products.PageCount > 1)
        {
            <div class="d-flex justify-content-center w-100">
                <nav class="mt-5" aria-label="Page navigation">
                    <ul class="pagination-modern">
                        @if (Model.Products.HasPreviousPage)
                        {
                            <li>
                                <a href="@Url.Action("Index", new { page = Model.Products.PageNumber - 1, categoryId = Model.SelectedCategoryId, searchTerm = Model.SearchTerm, productType = Model.SelectedProductType })" class="page-arrow">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li><span class="page-arrow disabled"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></span></li>
                        }

                        @for (int i = 1; i <= Model.Products.PageCount; i++)
                        {
                            if (i == Model.Products.PageNumber)
                            {
                                <li><span class="page-num active">@i</span></li>
                            }
                            else
                            {
                                <li><a href="@Url.Action("Index", new { page = i, categoryId = Model.SelectedCategoryId, searchTerm = Model.SearchTerm, productType = Model.SelectedProductType })" class="page-num">@i</a></li>
                            }
                        }

                        @if (Model.Products.HasNextPage)
                        {
                            <li>
                                <a href="@Url.Action("Index", new { page = Model.Products.PageNumber + 1, categoryId = Model.SelectedCategoryId, searchTerm = Model.SearchTerm, productType = Model.SelectedProductType })" class="page-arrow">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li><span class="page-arrow disabled"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></span></li>
                        }
                    </ul>
                </nav>
            </div>
        }

    </div>
</div>

@section Styles {
<style>

.catalog-hero {
    background: linear-gradient(120deg, #1F3A8A, #3A6EA5);
    padding: 60px;
    border-radius: 18px;
    color: white;
    box-shadow: 0 15px 40px rgba(0,0,0,0.08);
}

.catalog-hero h1 {
    font-weight: 600;
    margin-bottom: 10px;
}

.catalog-sidebar {
    background: white;
    padding: 30px;
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.04);
}

.filter-link {
    display: block;
    padding: 8px 0;
    color: #334155;
    text-decoration: none;
    transition: .2s;
}

.filter-link:hover {
    color: #1F3A8A;
    padding-left: 4px;
}

.filter-link.active {
    color: #C49A6C;
    font-weight: 600;
}

.product-card-modern {
    background: white;
    border-radius: 18px;
    overflow: hidden;
    transition: all .3s ease;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
}

.product-card-modern:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 50px rgba(0,0,0,0.08);
}

.product-image-modern {
    height: 240px;
    background: #F8FAFC;
    display: flex;
    align-items: center;
    justify-content: center;
}

.product-image-modern img {
    max-height: 100%;
    transition: transform .4s ease;
}

.product-card-modern:hover img {
    transform: scale(1.05);
}

.product-info-modern {
    padding: 20px;
}

.category-label {
    font-size: 0.8rem;
    color: #64748B;
}

.price-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 15px;
}

.price {
    font-weight: 600;
    font-size: 1.1rem;
    color: #1F3A8A;
}

.details-btn {
    background: #C49A6C;
    color: white;
    padding: 6px 14px;
    border-radius: 50px;
    text-decoration: none;
    transition: .3s;
}

.details-btn:hover {
    background: #b78957;
    transform: translateY(-2px);
}

</style>
}

@functions {
    public string ToThumb(string path)
    {
        if (string.IsNullOrEmpty(path)) return "/img/no-image.png";
        return path.Replace("/variant/", "/thumb/");
    }
}
