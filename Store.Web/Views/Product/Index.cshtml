@model Store.Web.ViewModels.Product.ProductCatalogViewModel

@{
    ViewData["Title"] = "Каталог товаров";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-3">
            <h4>Фильтры</h4>

            <form method="get" class="mb-4">
                <div class="input-group">
                    <input type="text"
                        name="searchTerm"
                        class="form-control"
                        placeholder="Поиск товара..."
                        value="@Model.SearchTerm" />
                    <button class="btn btn-primary" type="submit">🔍</button>
                </div>
            </form>

            <h5 class="mb-3">Категории</h5>

            <a href="@Url.Action("Index", "Product")"
            class="btn btn-outline-primary btn-sm d-block mb-2
            @(Model.SelectedCategoryId == null ? "active" : "")">
                Все товары
            </a>

            <div class="accordion" id="categoryFilter">
                @foreach (var group in Model.CategoryGroups)
                {
                    var collapseId = $"type-{group.ProductTypeId}";
                    var isExpanded = group.Categories.Any(c => c.Id == Model.SelectedCategoryId);

                    <div class="accordion-item mb-2">
                        <h2 class="accordion-header">
                            <button class="accordion-button py-2 @(isExpanded ? "" : "collapsed")"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#@collapseId"
                                    aria-expanded="@(isExpanded.ToString().ToLower())">
                                @group.ProductTypeName
                            </button>
                        </h2>

                        <div id="@collapseId"
                            class="accordion-collapse collapse @(isExpanded ? "show" : "")"
                            data-bs-parent="#categoryFilter">
                            <div class="accordion-body p-2">
                                @foreach (var category in group.Categories)
                                {
                                    <a href="@Url.Action("Index", "Product", new { categoryId = category.Id, page = 1 })"
                                    class="btn btn-outline-primary btn-sm d-block mb-1
                                    @(Model.SelectedCategoryId == category.Id ? "active" : "")">
                                        @category.Name
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>












        <!-- Основной контент -->
        <div class="col-md-9">
            <h2>@ViewData["Title"]</h2>

            @if (!Model.Products.Any())
            {
                <div class="alert alert-info">😕 Товары не найдены. Попробуйте изменить фильтры.</div>
            }
            else
            {
                <div class="row">
                    @foreach (var product in Model.Products)
                    {
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="card h-100 shadow-sm product-card">
                                <img src="@ToThumb(Url.Content(product.ImagePath))"
                                    class="card-img-top fade-img"
                                    loading="lazy"
                                    onload="this.classList.add('loaded')"
                                    alt="@product.Name"
                                    style="height:250px;object-fit:contain;">

                                <div class="card-body">
                                    <h5 class="card-title">@product.Name</h5>
                                    <p class="card-text text-muted small">@product.CategoryName</p>
                                    <h4 class="text-primary">@($"{product.Price?.Amount ?? 0:0.00} {product.Price?.Currency ?? "BYN"}")</h4>
                                </div>

                                <div class="card-footer bg-white">
                                    <a href="@Url.Action("Details", "Product", new { id = product.Id })" class="btn btn-primary btn-sm w-100">Подробнее</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Пагинация -->
                <nav aria-label="Page navigation" class="mt-4">
                    <ul class="pagination justify-content-center">
                        @if (Model.Products.HasPreviousPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", "Product", new { page = Model.Products.PageNumber - 1, categoryId = Model.SelectedCategoryId, searchTerm = Model.SearchTerm })">← Назад</a>
                            </li>
                        }
                        @for (int i = 1; i <= Model.Products.PageCount; i++)
                        {
                            <li class="page-item @(i == Model.Products.PageNumber ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", "Product", new { page = i, categoryId = Model.SelectedCategoryId, searchTerm = Model.SearchTerm })">@i</a>
                            </li>
                        }
                        @if (Model.Products.HasNextPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", "Product", new { page = Model.Products.PageNumber + 1, categoryId = Model.SelectedCategoryId, searchTerm = Model.SearchTerm })">Вперёд →</a>
                            </li>
                        }
                    </ul>
                    <div class="text-center text-muted">
                        <small>Страница @Model.Products.PageNumber из @Model.Products.PageCount | Всего: @Model.Products.TotalItemCount товаров</small>
                    </div>
                </nav>
            }
        </div>
    </div>
</div>

@section Styles {
    <style>
        .product-card { transition: transform 0.2s, box-shadow 0.2s; }
        .product-card:hover { transform: translateY(-5px); box-shadow: 0 8px 16px rgba(0,0,0,0.2) !important; }
        .btn-outline-primary.active { background-color: #0d6efd; color: white; }
    </style>
}

@functions {
    public string ToThumb(string path)
    {
        if (string.IsNullOrEmpty(path)) return "/img/no-image.png";
        return path.Replace("/variant/", "/thumb/");
    }
}
