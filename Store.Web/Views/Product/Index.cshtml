@model Store.Web.ViewModels.Product.ProductCatalogViewModel

@{
    ViewData["Title"] = "Каталог товаров";
}

<div class="container">

    

    <div class="row g-5 mt-4">

        <!-- Sidebar -->
        <div class="col-lg-3">
            <div class="catalog-sidebar">

                <h6 class="sidebar-title">Фильтры</h6>

                <form method="get" class="mb-4">
                    <div class="input-group">
                        <input type="text"
                               name="searchTerm"
                               class="form-control"
                               placeholder="Поиск..."
                               value="@Model.SearchTerm" />
                        <button class="btn btn-primary">Найти</button>
                    </div>
                </form>

                <a href="@Url.Action("Index", "Product")"
                   class="filter-link @(Model.SelectedCategoryId == null ? "active" : "")">
                    Все товары
                </a>

                <div class="accordion mt-3" id="categoryFilter">
                    @foreach (var group in Model.CategoryGroups)
                    {
                        var collapseId = $"type-{group.ProductTypeId}";
                        var isExpanded = group.Categories.Any(c => c.Id == Model.SelectedCategoryId);

                        <div class="accordion-item border-0">
                            <h2 class="accordion-header">
                                <button class="accordion-button @(isExpanded ? "" : "collapsed")"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#@collapseId">
                                    @group.ProductTypeName
                                </button>
                            </h2>

                            <div id="@collapseId"
                                 class="accordion-collapse collapse @(isExpanded ? "show" : "")">
                                <div class="accordion-body">
                                    @foreach (var category in group.Categories)
                                    {
                                        <a href="@Url.Action("Index", "Product", new { categoryId = category.Id, page = 1 })"
                                           class="filter-link @(Model.SelectedCategoryId == category.Id ? "active" : "")">
                                            @category.Name
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

            </div>
        </div>

        <!-- Products -->
        <div class="col-lg-9">

            <div class="row g-4">
                @foreach (var product in Model.Products)
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="product-card-modern">

                            <div class="product-image-modern">
                                <img src="@ToThumb(Url.Content(product.ImagePath))"
                                     class="fade-img"
                                     loading="lazy"
                                     onload="this.classList.add('loaded')"
                                     alt="@product.Name">
                            </div>

                            <div class="product-info-modern">
                                <h6>@product.Name</h6>
                                <span class="category-label">@product.CategoryName</span>

                                <div class="price-row">
                                    <div class="price">
                                        @($"{product.Price?.Amount ?? 0:0.00} {product.Price?.Currency ?? "BYN"}")
                                    </div>

                                    <a href="@Url.Action("Details", "Product", new { id = product.Id })"
                                       class="details-btn">
                                        Подробнее
                                    </a>
                                </div>
                            </div>

                        </div>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

@section Styles {
<style>

/* HERO */
.catalog-hero {
    background: linear-gradient(120deg, #1F3A8A, #3A6EA5);
    padding: 60px;
    border-radius: 18px;
    color: white;
    box-shadow: 0 15px 40px rgba(0,0,0,0.08);
}

.catalog-hero h1 {
    font-weight: 600;
    margin-bottom: 10px;
}

.catalog-sidebar {
    background: white;
    padding: 30px;
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.04);
}

.filter-link {
    display: block;
    padding: 8px 0;
    color: #334155;
    text-decoration: none;
    transition: .2s;
}

.filter-link:hover {
    color: #1F3A8A;
    padding-left: 4px;
}

.filter-link.active {
    color: #C49A6C;
    font-weight: 600;
}

/* Product Card */
.product-card-modern {
    background: white;
    border-radius: 18px;
    overflow: hidden;
    transition: all .3s ease;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
}

.product-card-modern:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 50px rgba(0,0,0,0.08);
}

.product-image-modern {
    height: 240px;
    background: #F8FAFC;
    display: flex;
    align-items: center;
    justify-content: center;
}

.product-image-modern img {
    max-height: 100%;
    transition: transform .4s ease;
}

.product-card-modern:hover img {
    transform: scale(1.05);
}

.product-info-modern {
    padding: 20px;
}

.category-label {
    font-size: 0.8rem;
    color: #64748B;
}

.price-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 15px;
}

.price {
    font-weight: 600;
    font-size: 1.1rem;
    color: #1F3A8A;
}

.details-btn {
    background: #C49A6C;
    color: white;
    padding: 6px 14px;
    border-radius: 50px;
    text-decoration: none;
    transition: .3s;
}

.details-btn:hover {
    background: #b78957;
    transform: translateY(-2px);
}

</style>
}

@functions {
    public string ToThumb(string path)
    {
        if (string.IsNullOrEmpty(path)) return "/img/no-image.png";
        return path.Replace("/variant/", "/thumb/");
    }
}
