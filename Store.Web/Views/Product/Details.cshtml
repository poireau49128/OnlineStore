@model Store.Domain.Entities.Product
@using System.Text.Json

<style>
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    input[type=number] {
        -moz-appearance: textfield;
    }

    .warehouse-btn.selected {
        background-color: #0d6efd;
        color: white;
    }
</style>

@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Product")">Каталог</a></li>
            <li class="breadcrumb-item">
                <a href="@Url.Action("Index", "Product", new { categoryId = Model.CategoryId })">@Model.Category?.Name</a>
            </li>
            <li class="breadcrumb-item active">@Model.Name</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-md-6">
            <img id="mainProductImage" src="@Url.Content(Model.GetMainImagePath())" class="img-fluid rounded shadow" alt="@Model.Name" style="max-height:600px;object-fit:cover;">
        </div>

        <div class="col-md-6">
            <h1>@Model.Name</h1>
            <p class="text-muted">
                <span class="badge bg-secondary">@Model.Category?.ProductType?.Name</span>
                <span class="badge bg-info">@Model.Category?.Name</span>
            </p>

            @if (!string.IsNullOrEmpty(Model.Sku))
            {
                <p class="small text-secondary"><strong>Артикул:</strong> @Model.Sku</p>
            }

            <h2 id="productPrice" class="text-primary mb-3">
                @($"{Model.BasePrice.Amount:0.00} {Model.BasePrice.Currency}")
            </h2>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="mb-4">
                    <h5>Описание</h5>
                    <p>@Html.Raw(Model.Description)</p>
                </div>
            }

            <!-- Варианты цветов -->
            @if (Model.Variants.Any())
            {
                <div class="mb-4">
                    <h5>Доступные цвета</h5>
                    <div id="colors" class="d-flex gap-2 flex-wrap">
                        @foreach (var v in Model.Variants
                            .OrderBy(v => v.Images.Any() ? v.Images.Min(i => i.SortOrder) : int.MaxValue))
                        {
                            <button class="btn btn-outline-secondary" onclick="selectVariant(@v.Id)">
                                @v.Color @(v.Size != null ? $"({v.Size})" : "")
                            </button>
                        }
                    </div>
                </div>
            }

            <!-- Наличие на складах -->
            <div class="mb-4">
                <h5>Наличие на складах</h5>
                <div id="stocks"><p class="text-muted">Загрузка...</p></div>
            </div>

            <div class="mb-4">
                <div class="input-group mb-3" style="max-width: 200px;">
                    <button class="btn btn-outline-secondary" type="button" id="qtyMinus">-</button>
                    <input type="number" class="form-control" value="1" min="1" id="quantity">
                    <button class="btn btn-outline-secondary" type="button" id="qtyPlus">+</button>
                </div>
                <button class="btn btn-primary btn-lg" onclick="addToCart()">🛒 Добавить в корзину</button>
            </div>

            <hr>
        </div>
    </div>
</div>

@{
    var variantsForJs = Model.Variants
        .OrderBy(v => v.Images.Any() ? v.Images.Min(i => i.SortOrder) : int.MaxValue)
        .Select(v => new {
            id = v.Id,
            imagePath = Url.Content(v.Images.OrderBy(i => i.SortOrder).FirstOrDefault()?.RelativePath ?? "/img/no-image.png"),
            priceAmount = v.GetPrice(Model.BasePrice).Amount,
            priceCurrency = v.GetPrice(Model.BasePrice).Currency
        })
        .ToList();

    var variantsJson = JsonSerializer.Serialize(variantsForJs, new JsonSerializerOptions { PropertyNamingPolicy = null });
}

@section Scripts {
<script>
    const variantsData = @Html.Raw(variantsJson);
    let selectedVariantId = variantsData[0]?.id || null;

    let selectedWarehouseId = null;
    let availableQuantity = 0;

    async function loadStocksForVariant(variantId) {
        try {
            const response = await fetch(`/Product/GetStock/${variantId}`);
            if (!response.ok) throw new Error("Network response was not ok: " + response.status);
            const stocks = await response.json();
            const div = document.getElementById('stocks');

            if (!stocks || !stocks.length) {
                div.innerHTML = '<p class="text-danger">Нет в наличии</p>';
                selectedWarehouseId = null;
                return;
            }

            let html = '';
            stocks.forEach((s, index) => {
                html += `<button type="button" class="btn btn-outline-secondary warehouse-btn ${index === 0 ? 'selected' : ''}" 
                            data-warehouse-id="${s.warehouse.id}" onclick="selectWarehouse(this)">
                            ${s.warehouse.name} - <strong>${s.quantity}</strong> шт
                         </button> `;
            });
            div.innerHTML = html;


            // Выбираем первый склад по умолчанию
            selectedWarehouseId = stocks[0].warehouse.id;

        } catch (e) {
            console.error("Stock load error:", e);
            document.getElementById('stocks').innerHTML = '<p class="text-danger">Ошибка загрузки данных</p>';
            selectedWarehouseId = null;
        }
    }

    function selectVariant(variantId) {
        selectedVariantId = variantId;

        const variant = variantsData.find(v => v.id === variantId);
        if (!variant) return;

        // картинка
        const img = document.getElementById('mainProductImage');
        if (img && variant.imagePath) img.src = variant.imagePath;

        // цена
        const priceElem = document.getElementById('productPrice');
        if (priceElem) priceElem.textContent = `${variant.priceAmount.toFixed(2)} ${variant.priceCurrency}`;

        // обновить остатки
        loadStocksForVariant(variantId);
    }

    function selectWarehouse(button) {
        document.querySelectorAll('.warehouse-btn').forEach(b => b.classList.remove('selected'));
        button.classList.add('selected');
        selectedWarehouseId = button.dataset.warehouseId;
    }

    document.addEventListener('DOMContentLoaded', () => {
        if (selectedVariantId) {
            loadStocksForVariant(selectedVariantId);
        }

        const qtyInput = document.getElementById("quantity");
        document.getElementById("qtyMinus").addEventListener("click", () => {
            let val = parseInt(qtyInput.value) || 1;
            qtyInput.value = Math.max(1, val - 1);
        });
        document.getElementById("qtyPlus").addEventListener("click", () => {
            let val = parseInt(qtyInput.value) || 1;
            qtyInput.value = val + 1;
        });
    });

    function addToCart() {
        if (!selectedVariantId || !selectedWarehouseId) {
            alert("Выберите вариант и склад с наличием товара");
            return;
        }

        const quantity = parseInt(document.getElementById("quantity").value) || 1;

        const form = document.createElement("form");
        form.method = "POST";
        form.action = "/Product/AddToCart";

        const inputs = [
            { name: "variantId", value: selectedVariantId },
            { name: "warehouseId", value: selectedWarehouseId },
            { name: "qty", value: quantity }
        ];

        inputs.forEach(inp => {
            const i = document.createElement("input");
            i.type = "hidden";
            i.name = inp.name;
            i.value = inp.value;
            form.appendChild(i);
        });

        document.body.appendChild(form);
        form.submit();
    }
</script>
}
