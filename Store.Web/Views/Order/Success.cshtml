@model int

@{
    ViewData["Title"] = "Заказ оформлен";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="alert alert-success" role="alert">
                <h4 class="alert-heading">✓ Заказ успешно оформлен!</h4>
                <p>
                    Спасибо за вашу покупку.  Ваш заказ успешно принят и обрабатывается. 
                </p>
                <hr>
                <p class="mb-0">
                    <strong>Номер заказа:</strong> #@Model
                </p>
            </div>

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Что дальше?</h5>
                    <ul>
                        <li>Вы получите email с подтверждением заказа</li>
                        <li>Статус заказа можно отследить в личном кабинете</li>
                        <li>Доставка обычно занимает 3-5 рабочих дней</li>
                    </ul>
                </div>
            </div>

            <div class="mt-4">
                <a href="@Url.Action("Index", "Product")" class="btn btn-primary">
                    ← Вернуться в каталог
                </a>
                <a href="@Url.Action("UserOrders", "Order")" class="btn btn-secondary ms-2">
                    Мои заказы →
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .container {
        background-color: #f8f9fa;
        padding: 40px 0;
        min-height: 70vh;
    }
</style>