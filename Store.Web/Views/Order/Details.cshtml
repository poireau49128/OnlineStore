@model Store.Web.ViewModels.Order.OrderDetailsViewModel

<div class="container">
    <div class="catalog-hero mb-5">
        <div class="hero-content">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="@Url.Action("UserOrders")" class="text-white-50 text-decoration-none">Мои заказы</a></li>
                    <li class="breadcrumb-item active text-white" aria-current="page">Детали</li>
                </ol>
            </nav>
            <h1>Заказ №@Model.Id</h1>
            <p>От @Model.CreatedAt.ToLocalTime().ToString("dd MMMM yyyy, HH:mm")</p>
        </div>
    </div>

    <div class="row g-5">
        <div class="col-lg-8">
            <h5 class="mb-4 section-subtitle">Состав заказа</h5>
            
            <div class="order-items-list">
                @foreach (var item in Model.Items)
                {
                    <div class="product-card-modern mb-4 p-3">
                        <div class="d-flex align-items-center gap-4">
                            <div class="order-item-icon">
                                <i class="bi bi-box-seam"></i>
                            </div>

                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start flex-wrap">
                                    <div>
                                        <h6 class="mb-1">@item.ProductName</h6>
                                        <div class="category-label mb-1">
                                            @item.Color @(string.IsNullOrEmpty(item.Size) ? "" : $"| {item.Size}")
                                        </div>
                                        <div class="text-muted small">
                                            <i class="bi bi-geo-alt me-1"></i>Склад: @item.WarehouseName
                                        </div>
                                    </div>

                                    <div class="text-end">
                                        <div class="qty-badge mb-2">
                                            @item.Quantity шт.
                                        </div>
                                        <div class="price">
                                            @item.Total.Amount.ToString("N2") @item.Price.Currency
                                        </div>
                                        <div class="text-muted small">
                                            @item.Price.Amount.ToString("N2") / ед.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(Model.Comment))
            {
                <div class="catalog-sidebar mt-4">
                    <h6 class="sidebar-title">Комментарий к заказу</h6>
                    <p class="text-muted mb-0">@Model.Comment</p>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="catalog-sidebar sticky-top" style="top: 100px;">
                <h5 class="sidebar-title border-bottom pb-3 mb-3">Резюме заказа</h5>
                
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="text-muted">Статус:</span>
                    <span class="status-badge">@Model.Status</span>
                </div>

                <div class="summary-details">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Позиций:</span>
                        <span class="fw-bold">@Model.Items.Count()</span>
                    </div>
                    <hr class="text-muted opacity-25">
                    <div class="d-flex justify-content-between align-items-end">
                        <span class="h5 mb-0">Итого:</span>
                        <div class="price-lg">
                            @Model.Total.Amount.ToString("N2") @Model.Total.Currency
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-2">
                    <a asp-action="UserOrders" class="btn-cart-outline">
                        <i class="bi bi-arrow-left me-2"></i>К списку заказов
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .catalog-hero {
            background: linear-gradient(120deg, #07604E, #64998C);
            padding: 50px 60px;
            border-radius: 24px;
            color: white;
            box-shadow: 0 15px 40px rgba(31, 58, 138, 0.15);
        }

        .section-subtitle {
            font-weight: 600;
            color: #07604E;
            letter-spacing: -0.5px;
        }

        .catalog-sidebar {
            background: white;
            padding: 30px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.04);
            border: 1px solid rgba(0,0,0,0.02);
        }

        .product-card-modern {
            background: white;
            border-radius: 20px;
            transition: all .3s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid transparent;
            box-shadow: 0 8px 20px rgba(0,0,0,0.03);
        }

        .product-card-modern:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.07);
            border-color: rgba(7, 96, 78, 0.1);
        }

        .order-item-icon {
            width: 80px;
            height: 80px;
            background: #F8FAFC;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            color: #07604E;
        }

        .qty-badge {
            background: #F1F5F9;
            color: #07604E;
            padding: 4px 12px;
            border-radius: 50px;
            font-size: 0.85rem;
            font-weight: 600;
            display: inline-block;
        }

        .status-badge {
            background: linear-gradient(135deg, #07604E, #0a8066);
            color: white;
            padding: 6px 16px;
            border-radius: 50px;
            font-size: 0.85rem;
            font-weight: 500;
            box-shadow: 0 4px 12px rgba(7, 96, 78, 0.2);
        }

        .price {
            font-weight: 700;
            font-size: 1.2rem;
            color: #07604E;
        }

        .price-lg {
            font-size: 1.8rem;
            font-weight: 700;
            color: #07604E;
            line-height: 1;
        }

        .category-label {
            font-size: 0.85rem;
            color: #64748B;
            font-weight: 500;
        }

        .breadcrumb-item + .breadcrumb-item::before {
            color: rgba(255,255,255,0.4);
        }
    </style>
}
