@model Store.Web.ViewModels.Order.OrderDetailsViewModel

<h2>Заказ №@Model.Id</h2>

<p>
    <strong>Дата:</strong> @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")<br />
    <strong>Статус:</strong> @Model.Status<br />
    <strong>Комментарий: </strong>@(Model.Comment ?? "отсутствует")
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Товар</th>
            <th>Цвет</th>
            <th>Размер</th>
            <th>Склад</th>
            <th>Кол-во</th>
            <th>Цена</th>
            @* <th>Скидка</th> *@
            <th>Итого</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.Color</td>
                <td>@item.Size</td>
                <td>@item.WarehouseName</td>
                <td>@item.Quantity</td>
                <td>@item.Price.Amount.ToString("0.00") @item.Price.Currency</td>
                @* <td>@item.Discount.ToString("0.##")%</td> *@
                <td>@item.Total.Amount.ToString("0.00") @item.Price.Currency</td>
            </tr>
        }
    </tbody>
</table>
<b>Общая стоимость: @Model.Total.Amount.ToString("0.00") @Model.Total.Currency</b><br>

<a asp-action="UserOrders" class="btn btn-secondary">← Назад к заказам</a>
